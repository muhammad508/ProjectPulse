# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectpulse"

# Secret used by Auth.js to sign sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the app
AUTH_URL="http://localhost:3000"

# Password given to the demo accounts created by `npx prisma db seed` (optional)
SEED_PASSWORD="demo-password"

# Database container credentials, used by Docker Compose only (defaults shown).
# Uncomment and change them for anything other than local use.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=projectpulse
